<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.santediagnostics.lims.controller.auth.ChangePasswordController"
      alignment="CENTER" spacing="16" styleClass="card" style="-fx-background-color: white;"
      stylesheets="@../../css/global.css">
    
    <padding>
        <Insets top="60" right="80" bottom="60" left="80"/>
    </padding>

    <VBox alignment="CENTER" spacing="8">
        <Label text="🔐 Change Password" styleClass="label-title"/>
        <Label text="You must change your password before continuing" styleClass="label-subtitle" wrapText="true" alignment="CENTER"/>
    </VBox>

    <VBox spacing="12" prefWidth="320">
        <PasswordField fx:id="newPasswordField" promptText="New Password" style="-fx-padding: 10 12;"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" style="-fx-padding: 10 12;"/>
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
        <Button text="Change Password" styleClass="btn-primary" prefWidth="320" onAction="#handleChange"/>
    </VBox>
</VBox>