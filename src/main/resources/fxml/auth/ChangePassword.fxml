<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.santediagnostics.lims.controller.auth.ChangePasswordController"
      alignment="CENTER" spacing="14" style="-fx-padding: 60 80; -fx-background-color: white;"
      stylesheets="@../../css/global.css">

    <Label text="Set New Password" styleClass="label-title"/>
    <Label text="You must change your password before continuing." style="-fx-text-fill: #666;"/>

    <PasswordField fx:id="newPasswordField" promptText="New Password" prefWidth="300"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" prefWidth="300"/>
    <Label fx:id="errorLabel" styleClass="error-label"/>

    <Button text="Change Password" styleClass="btn-primary" prefWidth="300" onAction="#handleChange"/>
</VBox>
