<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.santediagnostics.lims.controller.auth.RegisterController"
      alignment="CENTER" spacing="14" style="-fx-padding: 60 80; -fx-background-color: white;"
      stylesheets="@../../css/global.css">

    <Label text="Create Account" styleClass="label-title"/>

    <TextField fx:id="nameField" promptText="Full Name" prefWidth="300"/>
    <TextField fx:id="emailField" promptText="Email" prefWidth="300"/>
    <PasswordField fx:id="passwordField" promptText="Password (min 8 chars)" prefWidth="300"/>
    <Label fx:id="errorLabel" styleClass="error-label"/>

    <Button text="Register" styleClass="btn-primary" prefWidth="300" onAction="#handleRegister"/>
    <Button text="Back to Login" styleClass="btn-secondary" prefWidth="300" onAction="#goToLogin"/>
</VBox>
