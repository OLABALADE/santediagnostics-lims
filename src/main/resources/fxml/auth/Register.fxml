<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.santediagnostics.lims.controller.auth.RegisterController"
      alignment="CENTER" spacing="16" styleClass="card" style="-fx-background-color: white;"
      stylesheets="@../../css/global.css">
    
    <padding>
        <Insets top="60" right="80" bottom="60" left="80"/>
    </padding>

    <VBox alignment="CENTER" spacing="8">
        <Label text="📝 Create Account" styleClass="label-title"/>
        <Label text="Join Sante Diagnostics" styleClass="label-subtitle"/>
    </VBox>

    <VBox spacing="12" prefWidth="320">
        <TextField fx:id="nameField" promptText="Full Name" style="-fx-padding: 10 12;"/>
        <TextField fx:id="emailField" promptText="Email Address" style="-fx-padding: 10 12;"/>
        <PasswordField fx:id="passwordField" promptText="Password (min 8 characters)" style="-fx-padding: 10 12;"/>
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
        <Button text="Register" styleClass="btn-primary" prefWidth="320" onAction="#handleRegister"/>
        <Button text="Back to Login" styleClass="btn-secondary" prefWidth="320" onAction="#goToLogin"/>
    </VBox>
</VBox>