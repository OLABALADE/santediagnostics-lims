<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.santediagnostics.lims.controller.superadmin.UserManagementController"
      spacing="16" styleClass="card" style="-fx-background-color: white;"
      stylesheets="@../../css/global.css">
    
    <padding>
        <Insets top="40" right="80" bottom="40" left="80"/>
    </padding>

    <Label text="👥 Create Staff Account" styleClass="label-title"/>

    <VBox spacing="12" prefWidth="320">
        <TextField fx:id="nameField" promptText="Full Name" style="-fx-padding: 10 12;"/>
        <TextField fx:id="emailField" promptText="Email Address" style="-fx-padding: 10 12;"/>
        <ComboBox fx:id="roleCombo" promptText="Select Role" style="-fx-padding: 8 12;" prefWidth="320"/>
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
        <Label fx:id="successLabel" styleClass="success-label" wrapText="true"/>
        <Button text="Create Account" styleClass="btn-primary" prefWidth="320" onAction="#handleCreate"/>
        <Button text="← Back" styleClass="btn-secondary" prefWidth="320" onAction="#goBack"/>
    </VBox>
</VBox>