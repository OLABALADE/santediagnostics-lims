<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.santediagnostics.lims.controller.attendant.AttendantDashboardController"
      alignment="CENTER" spacing="16" style="-fx-padding: 60; -fx-background-color: white;"
      stylesheets="@../../css/global.css">

    <Label fx:id="welcomeLabel" styleClass="label-title"/>
    <Label text="Lab Attendant Dashboard" style="-fx-text-fill: #666;"/>

    <Button text="Request Queue"    styleClass="btn-primary"   prefWidth="260" onAction="#goToQueue"/>
    <Button text="Sample Tracking"  styleClass="btn-primary"   prefWidth="260" onAction="#goToSampleTracking"/>
    <Button text="Result Upload"    styleClass="btn-primary"   prefWidth="260" onAction="#goToResultUpload"/>
    <Button text="Logout"           styleClass="btn-secondary" prefWidth="260" onAction="#handleLogout"/>
</VBox>
