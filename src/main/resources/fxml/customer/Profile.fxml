<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.santediagnostics.lims.controller.customer.ProfileController"
      spacing="14" style="-fx-padding: 60 80; -fx-background-color: white;"
      stylesheets="@../../css/global.css">

    <Label text="My Profile" styleClass="label-title"/>

    <HBox spacing="10"><Label text="Name:"  style="-fx-font-weight: bold;"/><Label fx:id="nameLabel"/></HBox>
    <HBox spacing="10"><Label text="Email:" style="-fx-font-weight: bold;"/><Label fx:id="emailLabel"/></HBox>

    <Separator/>
    <Label text="Change Password" style="-fx-font-weight: bold;"/>
    <PasswordField fx:id="newPasswordField"     promptText="New Password"     prefWidth="300"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" prefWidth="300"/>
    <Label fx:id="errorLabel" styleClass="error-label"/>

    <Button text="Update Password" styleClass="btn-primary"   prefWidth="300" onAction="#handleChangePassword"/>
    <Button text="← Back"          styleClass="btn-secondary" prefWidth="300" onAction="#goBack"/>
</VBox>
