<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.santediagnostics.lims.controller.customer.BrowseTestsController"
      spacing="16" styleClass="card" style="-fx-background-color: white;"
      stylesheets="@../../css/global.css">
    
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="🔬 Available Tests" styleClass="label-title"/>

    <TableView fx:id="testTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="colName" text="Test Name" prefWidth="200"/>
            <TableColumn fx:id="colPrice" text="Price (₦)" prefWidth="120"/>
            <TableColumn fx:id="colTat" text="TAT (hours)" prefWidth="90"/>
            <TableColumn fx:id="colFormat" text="Result Format" prefWidth="100"/>
        </columns>
    </TableView>

    <Button text="Place Order" styleClass="btn-primary" prefWidth="200" onAction="#handleOrder"/>

    <VBox fx:id="bankDetailsBox" visible="false" spacing="8" style="-fx-background-color: #e8f5e9; -fx-background-radius: 8; -fx-padding: 15;">
        <Label text="🏦 Bank Transfer Details" style="-fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
        <Label fx:id="bankDetailsLabel" wrapText="true"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label"/>
    <Button text="← Back" styleClass="btn-secondary" onAction="#goBack"/>
</VBox>